# --- Client (Vite) — copy to `.env.local` for development ---

VITE_# Webhook idempotency needs the stripe_events table: run supabase-stripe-events-schema.sql
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Dev only: skip sign-in (npm run dev only; ignored in production builds)
# VITE_BYPASS_AUTH=true
# VITE_BYPASS_PRO=true

# Allow "Continue as Guest" when Supabase is configured (scenarios stay on-device)
# VITE_ALLOW_GUEST_PREVIEW=true

# Stripe price IDs (client — checkout picks monthly if unset)
# VITE_STRIPE_PRICE_PRO_MONTHLY=price_xxx
# VITE_STRIPE_PRICE_PRO_ANNUAL=price_xxx

# Optional telemetry
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://app.posthog.com

# --- Server (Vercel / api/stripe) — never expose service role to the client ---

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-side error reporting (api/). Optional; no-op when unset.
# SENTRY_DSN=

# Newsletter (api/beehiiv)
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
# BEEHIIV_AUTOMATION_ID=

# Daily write health check (api/health/writes, run by Vercel Cron — see vercel.json).
# CRON_SECRET: Vercel sends it as a bearer token; the endpoint refuses without it.
# WRITE_CANARY_USER_ID: a dedicated account's auth.users id; a canary row is
#   written to `scenarios` for it and deleted in the same run. Skipped when unset.
# WRITE_HEALTH_MAX_AGE_HOURS: alert when no real write has landed in this long.
#   Leave unset until there is daily traffic, or the alert fires every day.
# HEALTHCHECK_WRITES_PING_URL: a Healthchecks.io-style ping URL. Pinged on
#   success, `/fail` appended on failure; silence means the cron itself died.
# CRON_SECRET=
# WRITE_CANARY_USER_ID=
# WRITE_HEALTH_MAX_AGE_HOURS=24
# HEALTHCHECK_WRITES_PING_URL=
