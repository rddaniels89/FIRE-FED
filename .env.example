# --- Client (Vite) — copy to `.env.local` for development ---

VITE_# Webhook idempotency needs the stripe_events table: run supabase-stripe-events-schema.sql
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Dev only: skip sign-in (npm run dev only; ignored in production builds)
# VITE_BYPASS_AUTH=true
# VITE_BYPASS_PRO=true

# Allow "Continue as Guest" when Supabase is configured (scenarios stay on-device)
# VITE_ALLOW_GUEST_PREVIEW=true

# Stripe price IDs (client — checkout picks monthly if unset)
# VITE_STRIPE_PRICE_PRO_MONTHLY=price_xxx
# VITE_STRIPE_PRICE_PRO_ANNUAL=price_xxx

# Optional telemetry
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://app.posthog.com

# --- Server (Vercel / api/stripe) — never expose service role to the client ---

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
